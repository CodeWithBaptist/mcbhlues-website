# =============================================================================
# MCBHLUES ENTERPRISES — environment variables
#
# Copy to `.env.local` for local development (it is git-ignored), and mirror
# the values you need into Vercel → Settings → Environment Variables.
# Nothing here is required to run `npm run dev`: every variable has a safe
# default or degrades gracefully. See docs/DEPLOYMENT.md for the full guide.
# =============================================================================


# -----------------------------------------------------------------------------
# Public website
# -----------------------------------------------------------------------------

# Canonical origin of the site. NO trailing slash.
# Drives canonical <link> tags, sitemap.xml, robots.txt, and every Open Graph /
# Twitter card URL. Set this per environment so preview deployments do not
# advertise production URLs to crawlers.
# Default: https://mcbhlues.com
NEXT_PUBLIC_SITE_URL=https://mcbhlues.com


# -----------------------------------------------------------------------------
# Spam protection — Cloudflare Turnstile
# Get both keys from: Cloudflare dashboard → Turnstile → Add site.
# Add mcbhlues.com, www.mcbhlues.com and your *.vercel.app preview domain to the
# widget's hostname list.
#
# If these are left empty the captcha is simply not shown and verification is
# skipped — the honeypot field, the 16 KB body cap and the per-IP rate limits
# still protect the enquiry endpoint.
# -----------------------------------------------------------------------------

# Public site key (safe to expose in the browser).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key (server-side only — never commit a real value).
TURNSTILE_SECRET_KEY=


# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
# No variables needed. Vercel Analytics and Speed Insights are already wired
# into the root layout; enable them on the Vercel project to start collecting.
# Analytics loads only after the visitor accepts cookies. Speed Insights sets no
# cookies and always runs.


# -----------------------------------------------------------------------------
# Database — REQUIRED in production
# The Staff Portal stores staff accounts, roles, permissions and audit logs in
# PostgreSQL. Locally the app falls back to an embedded PGlite database, so you
# can leave this unset for development.
# -----------------------------------------------------------------------------

# DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Where the embedded development database is stored. Local only.
# PGLITE_DATA_DIR=./.data/pgdata


# -----------------------------------------------------------------------------
# Initial Staff Portal account (created on first boot)
# -----------------------------------------------------------------------------

# SUPER_ADMIN_EMAIL=superadmin@mcbhlues.com
# SUPER_ADMIN_PASSWORD=            # omit and a strong one is generated + logged once
# SUPER_ADMIN_FIRST_NAME=
# SUPER_ADMIN_LAST_NAME=

# `true` also creates the six demo role accounts. NEVER set this in production.
# SEED_DEMO_STAFF=false


# -----------------------------------------------------------------------------
# Outgoing email (optional)
# The portal's System Settings → Email delivery screen overrides these.
# Until SMTP is configured, outgoing messages are stored as "queued" and can be
# inspected under /portal/logs.
# -----------------------------------------------------------------------------

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false                # true for port 465
# EMAIL_FROM=hello@mcbhlues.com
# EMAIL_FROM_NAME=MCBHLUES ENTERPRISES


# -----------------------------------------------------------------------------
# Escape hatches — leave unset in production
# -----------------------------------------------------------------------------

# `true` disables the HTTP → HTTPS redirect in src/proxy.ts.
# Only for environments that terminate TLS in an unusual way.
# DISABLE_HTTPS_REDIRECT=

# `true` drops the X-Frame-Options: SAMEORIGIN header so the site can be
# embedded in an iframe (sandboxed previews). Read at BUILD time by
# next.config.ts, so changing it requires a rebuild/redeploy.
# ALLOW_FRAMING=
